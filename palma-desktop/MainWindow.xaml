<Window x:Class="PalmaDesktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PALMA Desktop" Width="1200" Height="860" MinWidth="1040" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="#0B1019" Foreground="#F1F3F8"
 FontFamily="Segoe UI" FontSize="14" FlowDirection="RightToLeft" Icon="assets/palma-logo.png">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#98A4B9"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#202B3D"/><Setter Property="Foreground" Value="#F1F3F8"/>
   <Setter Property="BorderBrush" Value="#354258"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="17,11"/><Setter Property="MinHeight" Value="44"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.82"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#F4D8A1"/><Setter TargetName="Body" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="CornerRadius" Value="14"/><Setter Property="Background" Value="#131C2A"/><Setter Property="BorderBrush" Value="#263248"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#101725" BorderBrush="#233047" BorderThickness="0,0,0,0">
   <Grid Margin="20,26,20,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <Image Source="assets/palma-logo.png" Width="84" Height="84" Margin="0,0,0,16"/>
     <TextBlock Text="PALMA VISION" FlowDirection="LeftToRight" FontSize="19" FontWeight="SemiBold" TextAlignment="Center"/>
     <TextBlock Text="تجربتك على اللابتوب" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,5,0,34"/>
     <Border Background="#2F2D29" BorderBrush="#6C5D40" BorderThickness="1" CornerRadius="9" Padding="14,13" Margin="0,0,0,14">
      <TextBlock Text="تشغيل بالما" Foreground="#E8D3AB" FontWeight="SemiBold"/>
     </Border>
     <Button Content="دليل الإعداد" Click="HelpClick" HorizontalContentAlignment="Right" Margin="0,0,0,10"/>
     <Button Content="حفظ تقرير الفحص" Click="ReportClick" Margin="0,0,0,10"/>
     <Button Content="فتح موقع بالما" Click="WebsiteClick"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <Border Background="#182133" CornerRadius="10" Padding="13">
      <StackPanel><TextBlock Text="نفس تطبيق Android" Foreground="#DBC9A8" FontWeight="SemiBold"/>
       <TextBlock Text="يعمل داخل BlueStacks مع دعم ARM64." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
      </StackPanel>
     </Border>
     <TextBlock Text="WINDOWS  ·  1.0.1" FlowDirection="LeftToRight" TextAlignment="Center" Foreground="#68768D" FontSize="11" Margin="0,18,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="32,28,32,28">
    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="مساحتك للمشاهدة" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="الإعداد والتشغيل" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
     <Border Grid.Column="1" Background="#192231" CornerRadius="16" Padding="14,8" VerticalAlignment="Center"><TextBlock Text="Windows 64-bit" FlowDirection="LeftToRight" FontSize="12" Foreground="#C8D0DE"/></Border>
    </Grid>
    <Border CornerRadius="18" BorderBrush="#504938" BorderThickness="1" Padding="28" Margin="0,0,0,20">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#252C38" Offset="0"/><GradientStop Color="#181F2C" Offset="1"/></LinearGradientBrush></Border.Background>
     <StackPanel>
      <TextBlock Text="PALMA ON DESKTOP" FlowDirection="LeftToRight" HorizontalAlignment="Right" FontSize="11" Foreground="#DFC483" Margin="0,0,0,10"/>
      <TextBlock Text="بالما، على شاشة أكبر." FontSize="34" FontWeight="SemiBold" Margin="0,0,0,9"/>
      <TextBlock Text="افتح تطبيقك الأصلي بقوائمه وواجهاته نفسها. جهّز بيئة التشغيل مرة واحدة، ثم ابدأ المشاهدة من داخل بالما." Foreground="#BAC5D6" FontSize="15" LineHeight="25" MaxWidth="630" HorizontalAlignment="Right"/>
      <WrapPanel Margin="0,22,0,0">
       <Button x:Name="LaunchButton" Content="تشغيل بالما  ←" Background="#DFC483" Foreground="#181A20" BorderBrush="#EEDAAE" FontWeight="SemiBold" MinWidth="166" Click="LaunchClick" Margin="0,0,0,8"/>
       <Button x:Name="CheckButton" Content="فحص الجاهزية" Click="CheckClick" Margin="10,0,0,8"/>
       <Button x:Name="OpenEngineButton" Content="فتح BlueStacks" Click="OpenEngineClick" Margin="10,0,0,8"/>
      </WrapPanel>
     </StackPanel>
    </Border>
    <Grid Margin="0,0,0,20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Margin="0,0,0,0"><StackPanel>
      <TextBlock Text="01  ·  بيئة التشغيل" Foreground="{StaticResource Muted}" FontSize="12"/>
      <TextBlock x:Name="RuntimeStatus" Text="بانتظار الفحص" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/>
      <TextBlock Text="Android 9+ مع ARM64" FontSize="12" Foreground="{StaticResource Muted}"/>
     </StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel>
      <TextBlock Text="02  ·  ملف بالما" Foreground="{StaticResource Muted}" FontSize="12"/>
      <TextBlock x:Name="ApkStatus" Text="جارٍ التحقق" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/>
      <TextBlock Text="النسخة الأصلية 1.1.7" FontSize="12" Foreground="{StaticResource Muted}"/>
     </StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel>
      <TextBlock Text="03  ·  ملحقات المشاهدة" Foreground="{StaticResource Muted}" FontSize="12"/>
      <TextBlock x:Name="PlayerStatus" Text="بانتظار الفحص" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/>
      <TextBlock Text="TDM المعدّل + MX Player" FontSize="12" Foreground="{StaticResource Muted}"/>
     </StackPanel></Border>
    </Grid>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
     <StackPanel>
      <TextBlock Text="اختر بيئة التشغيل" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="InstanceBox" DisplayMemberPath="Label" MinHeight="42" VerticalContentAlignment="Center" Foreground="#152033" Background="White" Padding="9,6" SelectionChanged="InstanceChanged" AutomationProperties.Name="نسخة BlueStacks"/>
       <Button x:Name="RefreshButton" Grid.Column="1" Content="تحديث" Click="RefreshClick" Margin="10,0,0,0"/>
       <Button x:Name="BrowseButton" Grid.Column="2" Content="تحديد المحرك" Click="BrowseEngineClick" Margin="10,0,0,0"/>
      </Grid>
      <TextBlock Text="في BlueStacks: افتح Settings ثم Advanced وفعّل Android Debug Bridge، واضغط Save changes." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,12"/>
      <WrapPanel>
       <Button Content="تنزيل BlueStacks" Click="DownloadClick" FontSize="12" Padding="12,8" Margin="0,0,0,6"/>
       <Button x:Name="CompanionButton" Content="إضافة TDM أو MX من ملف" Click="CompanionClick" FontSize="12" Padding="12,8" Margin="8,0,0,6"/>
       <Button x:Name="PhoneButton" Content="نسخ الملحقات من الهاتف" Click="PhoneClick" FontSize="12" Padding="12,8" Margin="8,0,0,6"/>
      </WrapPanel>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
   <StackPanel Grid.Row="1" Margin="32,10,32,18">
    <Border Background="#111B27" BorderBrush="#293D4E" BorderThickness="1" CornerRadius="12" Padding="16">
     <StackPanel>
      <TextBlock x:Name="StatusTitle" Text="لنبدأ بخطوة واحدة" Foreground="#DEC999" FontWeight="SemiBold" Margin="0,0,0,5"/>
      <TextBlock x:Name="StatusText" Text="اختر نسخة BlueStacks، ثم اضغط تشغيل بالما. استخدم دليل الإعداد إذا كانت هذه المرة الأولى." Foreground="#AEBBCB" FontSize="13" LineHeight="22"/>
      <ProgressBar x:Name="ProgressBar" Height="3" Margin="0,13,0,0" IsIndeterminate="True" Foreground="#DFC483" Background="#263348" Visibility="Collapsed"/>
      <Button x:Name="CancelButton" Content="إلغاء العملية" Click="CancelClick" Visibility="Collapsed" HorizontalAlignment="Left" Padding="12,6" MinHeight="32" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
    <TextBlock Text="يتم التأكد من ظهور القوائم وتشغيل الفيديو داخل بالما بعد فتحه. توفر المحتوى يتبع حالة خادم المصدر." Foreground="#78869C" FontSize="12" Margin="2,10,2,0"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
